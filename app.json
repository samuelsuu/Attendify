{
  "expo": {
    "name": "Webcapz",
    "slug": "Webcapz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/webcap_Icon2.png",
    "scheme": "attendance",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tachii.Webcapz",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/webcap_Icon2.png",
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.tachii.Webcapz"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/webcap_Icon2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/webcap_Icon2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow the app to access your camera to scan attendance QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow the app to access your photos to set a profile picture.",
          "cameraPermission": true,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "71c29110-1050-4187-8cc2-abc8dfc57376"
      }
    }
  }
}